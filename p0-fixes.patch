@@ -0,0 +1,282 @@
+from __future__ import annotations
+
+from collections.abc import Iterator
+from datetime import datetime
+from decimal import Decimal
+
+import pytest
+from sqlalchemy import create_engine, func, select
+from sqlalchemy.orm import Session, sessionmaker
+
+from core.classify import classify_one, classify_transactions, reapply_all
+from core.enrich import enrich
+from core.models import (
+    Account,
+    Bank,
+    Base,
+    Category,
+    Counterparty,
+    ImportBatch,
+    OwnAccount,
+    Rule,
+    Transaction,
+)
+from core.parsers.base import RawTxn
+from core.seed import DEFAULT_CATEGORIES, DEFAULT_RULES, seed
+
+SYNTHETIC_QPAY_FEE_ACCOUNT = "9900000001"
+POSTED = datetime(2026, 1, 2, 10, 0, 0)
+
+
+@pytest.fixture
+def db_session() -> Iterator[Session]:
+    engine = create_engine("sqlite://")
+    Base.metadata.create_all(engine)
+    session = sessionmaker(bind=engine, expire_on_commit=False)()
+    try:
+        yield session
+    finally:
+        session.close()
+        Base.metadata.drop_all(engine)
+        engine.dispose()
+
+
+def _count(session: Session, model: type) -> int:
+    return session.execute(select(func.count()).select_from(model)).scalar_one()
+
+
+# --------------------------------------------------------------------------- seeding
+
+
+def test_seed_fresh_database_creates_defaults(db_session: Session) -> None:
+    result = seed(db_session)
+
+    assert result.banks_added == 1
+    assert result.categories_added == len(DEFAULT_CATEGORIES)
+    assert result.rules_added == len(DEFAULT_RULES)
+    assert result.warnings == []
+
+    assert db_session.execute(select(Bank.name).where(Bank.code == "GOLOMT")).scalar_one() == "Golomt Bank"
+    kinds = dict(db_session.execute(select(Category.name, Category.kind)).all())
+    assert kinds["Savings"] == "savings"
+    assert kinds["Bank fees"] == "expense"
+    assert kinds["Own account transfer"] == "transfer"
+    assert all(c.is_default for c in db_session.execute(select(Category)).scalars())
+
+    rules = db_session.execute(select(Rule)).scalars().all()
+    assert {(r.field, r.match_type, r.pattern) for r in rules} == {
+        ("txn_type", "equals", "fee"),
+        ("txn_type", "equals", "own_transfer"),
+    }
+    assert all(r.active for r in rules)
+
+
+def test_seed_creates_no_personal_records(db_session: Session) -> None:
+    seed(db_session)
+
+    assert _count(db_session, OwnAccount) == 0
+    assert _count(db_session, Counterparty) == 0
+
+
+def test_seed_is_idempotent(db_session: Session) -> None:
+    seed(db_session)
+    before = (_count(db_session, Bank), _count(db_session, Category), _count(db_session, Rule))
+
+    for _ in range(3):
+        again = seed(db_session)
+        assert again.total_added == 0
+
+    after = (_count(db_session, Bank), _count(db_session, Category), _count(db_session, Rule))
+    assert after == before
+
+
+def test_seed_does_not_overwrite_user_categories_or_rules(db_session: Session) -> None:
+    custom_category = Category(name="My Fees", kind="expense", sort_order=1, is_default=False)
+    edited_default = Category(name="Bank fees", kind="expense", sort_order=999, is_default=False)
+    db_session.add_all([custom_category, edited_default])
+    db_session.flush()
+    # The user already owns a rule for txn_type == fee, retargeted to their own category.
+    user_rule = Rule(
+        priority=5, field="txn_type", match_type="equals", pattern="fee",
+        category_id=custom_category.id, active=False,
+    )
+    other_rule = Rule(
+        priority=77, field="merchant", match_type="contains", pattern="MYSHOP",
+        category_id=custom_category.id, active=True,
+    )
+    db_session.add_all([user_rule, other_rule])
+    db_session.commit()
+
+    result = seed(db_session)
+
+    assert result.categories_added == len(DEFAULT_CATEGORIES) - 1  # only "Bank fees" existed
+    assert db_session.execute(select(func.count()).where(Category.name == "Bank fees")).scalar_one() == 1
+    db_session.refresh(edited_default)
+    assert (edited_default.sort_order, edited_default.is_default) == (999, False)
+    db_session.refresh(user_rule)
+    assert (user_rule.priority, user_rule.category_id, user_rule.active) == (5, custom_category.id, False)
+    assert db_session.execute(
+        select(func.count()).where(Rule.field == "txn_type", Rule.pattern == "fee")
+    ).scalar_one() == 1  # not duplicated
+    db_session.refresh(other_rule)
+    assert (other_rule.priority, other_rule.pattern) == (77, "MYSHOP")
+    assert db_session.get(Category, custom_category.id).name == "My Fees"
+
+
+def test_seed_on_database_seeded_by_old_version_only_adds_missing_savings(db_session: Session) -> None:
+    for name, kind, order in DEFAULT_CATEGORIES:
+        if name != "Savings":
+            db_session.add(Category(name=name, kind=kind, sort_order=order, is_default=True))
+    db_session.commit()
+
+    result = seed(db_session)
+
+    assert result.categories_added == 1
+    assert db_session.execute(select(Category.kind).where(Category.name == "Savings")).scalar_one() == "savings"
+
+
+def test_seed_warns_about_legacy_broad_fee_rule_without_changing_it(db_session: Session) -> None:
+    seed(db_session)
+    bank_fees = db_session.execute(select(Category).where(Category.name == "Bank fees")).scalar_one()
+    legacy = Rule(
+        priority=100, field="description", match_type="contains", pattern="FEE",
+        category_id=bank_fees.id, active=True,
+    )
+    db_session.add(legacy)
+    db_session.commit()
+
+    result = seed(db_session)
+
+    assert any("'FEE'" in w for w in result.warnings)
+    db_session.refresh(legacy)
+    assert (legacy.field, legacy.match_type, legacy.pattern, legacy.active) == (
+        "description", "contains", "FEE", True,
+    )
+
+    legacy.active = False
+    db_session.commit()
+    assert seed(db_session).warnings == []
+
+
+# ------------------------------------------------------------------ fee rule regression
+
+
+def _classify_description(
+    session: Session,
+    description: str,
+    *,
+    direction: str = "out",
+    counterparty_account: str | None = None,
+    my_accounts: set[str] | None = None,
+) -> str | None:
+    """Run the real enrich() -> classify_one() pipeline against the seeded rules."""
+    item = enrich(
+        RawTxn(
+            posted_at=POSTED, txn_at=POSTED, amount=Decimal("10.00"), direction=direction,  # type: ignore[arg-type]
+            description=description, counterparty_account=counterparty_account,
+        ),
+        my_accounts or set(),
+    )
+    txn = Transaction(
+        description=description, merchant=item.merchant, txn_type=item.txn_type,
+        counterparty_account=item.counterparty_account, category_source="none",
+    )
+    rules = session.execute(
+        select(Rule).where(Rule.active.is_(True)).order_by(Rule.priority, Rule.id)
+    ).scalars().all()
+    category_id, _source = classify_one(txn, list(rules))
+    return None if category_id is None else session.get(Category, category_id).name
+
+
+@pytest.fixture
+def seeded(db_session: Session, monkeypatch: pytest.MonkeyPatch) -> Session:
+    monkeypatch.setattr("core.enrich.QPAY_FEE_ACCOUNTS", frozenset({SYNTHETIC_QPAY_FEE_ACCOUNT}))
+    seed(db_session)
+    return db_session
+
+
+@pytest.mark.parametrize(
+    ("description", "account"),
+    [
+        ("EASYINFO fee for POS20260102,SMS", None),
+        ("Charges for PORD Customer Payment :123456", None),
+        ("QPAY payment", SYNTHETIC_QPAY_FEE_ACCOUNT),
+    ],
+)
+def test_real_fee_descriptions_are_classified_as_bank_fees(
+    seeded: Session, description: str, account: str | None
+) -> None:
+    assert _classify_description(seeded, description, counterparty_account=account) == "Bank fees"
+
+
+@pytest.mark.parametrize(
+    "description",
+    [
+        "COFFEE SHOP PURCHASE",
+        "Feedback refund",
+        "Fee-free account promotion",
+        "Coffee beans and 3 coffees",
+        "400000******1111:02-01-2026 10:02:00:POS:COFFEE HOUSE",
+        "SOCIALPAY гүйлгээ, Coffee",
+        "Bonfire Festival ticket",
+    ],
+)
+def test_fee_lookalike_descriptions_are_not_bank_fees(seeded: Session, description: str) -> None:
+    assert _classify_description(seeded, description) is None
+
+
+def test_qpay_to_ordinary_biller_is_not_a_bank_fee(seeded: Session) -> None:
+    assert _classify_description(seeded, "QPAY payment", counterparty_account="5551234567") is None
+
+
+def test_own_account_transfer_rule(seeded: Session) -> None:
+    category = _classify_description(
+        seeded, "Transfer", counterparty_account="1234567890", my_accounts={"1234567890"}
+    )
+    assert category == "Own account transfer"
+
+
+def test_manual_category_beats_fee_rule(seeded: Session) -> None:
+    groceries = seeded.execute(select(Category).where(Category.name == "Groceries")).scalar_one()
+
+    manual = Transaction(txn_type="fee", category_id=groceries.id, category_source="manual")
+    rules = list(seeded.execute(select(Rule).order_by(Rule.priority, Rule.id)).scalars())
+    assert classify_one(manual, rules) == (groceries.id, "manual")
+
+
+def test_reapply_all_keeps_manual_fee_category_and_fixes_automatic_one(seeded: Session) -> None:
+    bank = Bank(code="TEST", name="Test Bank")
+    seeded.add(bank)
+    seeded.flush()
+    account = Account(bank_id=bank.id, account_no="1234", currency="MNT")
+    seeded.add(account)
+    seeded.flush()
+    batch = ImportBatch(
+        account_id=account.id, file_name="t.xlsx", file_sha256="a" * 64,
+        total_rows=2, new_rows=2, duplicate_rows=0,
+    )
+    groceries = seeded.execute(select(Category).where(Category.name == "Groceries")).scalar_one()
+    bank_fees = seeded.execute(select(Category).where(Category.name == "Bank fees")).scalar_one()
+    seeded.add(batch)
+    seeded.flush()
+
+    def make(n: int, source: str, category_id: int | None) -> Transaction:
+        return Transaction(
+            account_id=account.id, batch_id=batch.id, posted_at=POSTED, txn_at=POSTED,
+            amount=Decimal("1.00"), direction="out", description="EASYINFO fee for X",
+            txn_type="fee", category_id=category_id, category_source=source,
+            raw={}, dedupe_hash=f"h{n}".ljust(64, "0"),
+        )
+
+    manual = make(1, "manual", groceries.id)
+    automatic = make(2, "none", None)
+    seeded.add_all([manual, automatic])
+    seeded.commit()
+
+    reapply_all(seeded)
+
+    seeded.refresh(manual)
+    seeded.refresh(automatic)
+    assert (manual.category_id, manual.category_source) == (groceries.id, "manual")
+    assert (automatic.category_id, automatic.category_source) == (bank_fees.id, "rule")
+    assert classify_transactions(seeded) == 0  # stable on a second pass
