+def test_savings_is_an_outflow_of_cash_consistent_with_existing_model(ledger: Ledger) -> None:
+    ledger.add("500.00", "in", "income")
+    ledger.add("200.00", "out", "savings")
+    ledger.session.commit()
+
+    s = cashflow_summary(ledger.session, DAY, DAY)
+    assert (s["savings"], s["expenses"], s["net_cash_flow"]) == (D("200.00"), D("0"), D("300.00"))
+    # a savings *withdrawal* (inflow) is neither income nor lost
+    ledger.add("50.00", "in", "savings")
+    ledger.session.commit()
+    s = cashflow_summary(ledger.session, DAY, DAY)
+    assert (s["income"], s["other_in"], s["net_cash_flow"]) == (D("500.00"), D("50.00"), D("350.00"))
