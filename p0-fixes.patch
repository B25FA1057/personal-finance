+def _flow_bucket_columns() -> dict:
+    """SQL sums that split every transaction into exactly one cash-flow bucket.
+
+    The query must outer-join Category so uncategorized rows are kept. Internal transfers
+    (txn_type "own_transfer" or a category of kind "transfer") are separated first; the
+    rest is split by direction and category kind:
+
+    inflows:  income | uncategorized_in | other_in (categorized, but not as income, e.g. a refund)
+    outflows: expenses | savings | uncategorized_out | other_out (e.g. a reversal filed as income)
+
+    Every row falls in one bucket, so nothing is dropped or counted twice. Category.kind is
+    wrapped in coalesce so a NULL kind (uncategorized) never turns a condition into NULL.
+    """
+    kind = func.coalesce(Category.kind, "")
+    is_in = Transaction.direction == "in"
+    is_out = Transaction.direction == "out"
+    transfer = (Transaction.txn_type == "own_transfer") | (kind == "transfer")
+    external = ~transfer
+    uncategorized = Transaction.category_id.is_(None)
+
+    def total(condition):
+        return func.coalesce(func.sum(case((condition, Transaction.amount), else_=0)), 0)
+
+    return {
+        "income": total(is_in & external & (kind == "income")),
+        "uncategorized_in": total(is_in & external & uncategorized),
+        "other_in": total(is_in & external & ~uncategorized & (kind != "income")),
+        "expenses": total(is_out & external & (kind == "expense")),
+        "savings": total(is_out & external & (kind == "savings")),
+        "uncategorized_out": total(is_out & external & uncategorized),
+        "other_out": total(
+            is_out & external & ~uncategorized & ~kind.in_(["expense", "savings"])
+        ),
+        "transfers_in": total(is_in & transfer),
+        "transfers_out": total(is_out & transfer),
+    }
+
+
+def cashflow_summary(
+    session: Session,
+    date_from: date | datetime | None = None,
+    date_to: date | datetime | None = None,
+) -> dict[str, Decimal]:
+    """Period totals for the dashboard KPIs.
+
+    Buckets (see ``_flow_bucket_columns``) are mutually exclusive. Derived values:
+    ``total_inflows``/``total_outflows`` cover all non-transfer money movement and
+    ``net_cash_flow`` is their difference. Savings count as an outflow of cash.
+    ``fees`` (txn_type "fee") is informational: those rows are already inside the buckets
+    above (normally ``expenses``), so it must not be added to them. Internal transfers are
+    reported separately and are excluded from every cash-flow total.
+    """
+    buckets = _flow_bucket_columns()
+    fees = func.coalesce(
+        func.sum(case((Transaction.txn_type == "fee", Transaction.amount), else_=0)), 0
+    )
+    statement = (
+        select(*[column.label(name) for name, column in buckets.items()], fees.label("fees"))
+        .select_from(Transaction)
+        .outerjoin(Category, Category.id == Transaction.category_id)
+        .where(*_date_conditions(date_from, date_to))
+    )
+    row = session.execute(statement).one()
+    summary = {name: Decimal(str(getattr(row, name))) for name in [*buckets, "fees"]}
+    summary["total_inflows"] = (
+        summary["income"] + summary["uncategorized_in"] + summary["other_in"]
+    )
+    summary["total_outflows"] = (
+        summary["expenses"]
+        + summary["savings"]
+        + summary["uncategorized_out"]
+        + summary["other_out"]
+    )
+    summary["net_cash_flow"] = summary["total_inflows"] - summary["total_outflows"]
+    return summary
+
+
+def _monthly_cashflow_full_df(
+    session: Session,
+    date_from: date | datetime | None,
+    date_to: date | datetime | None,
+) -> pd.DataFrame:
+    year = extract("year", Transaction.txn_at).label("year")
+    month = extract("month", Transaction.txn_at).label("month")
+    buckets = _flow_bucket_columns()
+    names = [
+        "income",
+        "uncategorized_in",
+        "other_in",
+        "expenses",
+        "savings",
+        "uncategorized_out",
+        "other_out",
+    ]
+    statement = (
+        select(year, month, *[buckets[name].label(name) for name in names])
+        .select_from(Transaction)
+        .outerjoin(Category, Category.id == Transaction.category_id)
+        .where(*_dashboard_date_filters(date_from, date_to))
+        .group_by(year, month)
+        .order_by(year, month)
+    )
+    records = []
+    for row in session.execute(statement).all():
+        values = {name: Decimal(str(getattr(row, name))) for name in names}
+        net = (
+            values["income"]
+            + values["uncategorized_in"]
+            + values["other_in"]
+            - values["expenses"]
+            - values["savings"]
+            - values["uncategorized_out"]
+            - values["other_out"]
+        )
+        records.append(
+            {"month": f"{int(row.year):04d}-{int(row.month):02d}", **values, "net_cash_flow": net}
+        )
+    return pd.DataFrame(records, columns=["month", *names, "net_cash_flow"])
+
+
