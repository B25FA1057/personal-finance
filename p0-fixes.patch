@@ -0,0 +1,237 @@
+from __future__ import annotations
+
+from collections.abc import Iterator
+from datetime import date, datetime
+from decimal import Decimal
+from itertools import count
+
+import pytest
+from sqlalchemy import create_engine
+from sqlalchemy.orm import Session, sessionmaker
+
+from core.models import Account, Bank, Base, Category, Counterparty, ImportBatch, Transaction
+from core.queries import cashflow_summary, monthly_cashflow_df
+
+D = Decimal
+DAY = date(2026, 10, 20)
+BUCKETS = (
+    "income", "uncategorized_in", "other_in", "expenses", "savings",
+    "uncategorized_out", "other_out", "transfers_in", "transfers_out",
+)
+
+
+@pytest.fixture
+def db_session() -> Iterator[Session]:
+    engine = create_engine("sqlite://")
+    Base.metadata.create_all(engine)
+    session = sessionmaker(bind=engine, expire_on_commit=False)()
+    try:
+        yield session
+    finally:
+        session.close()
+        Base.metadata.drop_all(engine)
+        engine.dispose()
+
+
+class Ledger:
+    """Small helper that adds transactions to one account/batch."""
+
+    def __init__(self, session: Session) -> None:
+        self.session = session
+        bank = Bank(code="TEST", name="Test Bank")
+        session.add(bank)
+        session.flush()
+        account = Account(bank_id=bank.id, account_no="1234", currency="MNT")
+        session.add(account)
+        session.flush()
+        batch = ImportBatch(
+            account_id=account.id, file_name="t.xlsx", file_sha256="a" * 64,
+            total_rows=1, new_rows=1, duplicate_rows=0,
+        )
+        counterparty = Counterparty(key="M:PAYEE", kind="merchant", display_name="Payee")
+        session.add_all([batch, counterparty])
+        session.flush()
+        self.account, self.batch, self.counterparty = account, batch, counterparty
+        self.cat = {
+            "income": Category(name="Salary", kind="income"),
+            "expense": Category(name="Dining", kind="expense"),
+            "savings": Category(name="Savings", kind="savings"),
+            "transfer": Category(name="Own transfer", kind="transfer"),
+        }
+        session.add_all(self.cat.values())
+        session.flush()
+        self._n = count(1)
+
+    def add(
+        self,
+        amount: str,
+        direction: str,
+        category: str | None,
+        *,
+        txn_type: str = "other",
+        when: datetime = datetime(2026, 10, 20, 12, 0, 0),
+    ) -> None:
+        self.session.add(
+            Transaction(
+                account_id=self.account.id, batch_id=self.batch.id, posted_at=when, txn_at=when,
+                amount=D(amount), direction=direction, description="x", txn_type=txn_type,
+                counterparty_id=self.counterparty.id,
+                category_id=self.cat[category].id if category else None,
+                category_source="none", raw={}, dedupe_hash=f"{next(self._n):064d}",
+            )
+        )
+
+
+@pytest.fixture
+def ledger(db_session: Session) -> Ledger:
+    return Ledger(db_session)
+
+
+def _populate(led: Ledger) -> None:
+    led.add("1000.00", "in", "income")                              # income
+    led.add("300.00", "in", None, txn_type="p2p_in")                # uncategorized inflow
+    led.add("40.00", "in", "expense")                               # refund filed as expense
+    led.add("20.00", "in", "savings")                               # savings withdrawal
+    led.add("10000.00", "in", "income", txn_type="own_transfer")    # transfer in (typed)
+    led.add("7.00", "in", None, txn_type="own_transfer")            # transfer in, uncategorized
+    led.add("250.00", "out", "expense")                             # expense
+    led.add("5.00", "out", "expense", txn_type="fee")               # fee (inside expenses)
+    led.add("100.00", "out", "savings")                             # savings deposit
+    led.add("60.00", "out", None)                                   # uncategorized outflow
+    led.add("15.00", "out", "income")                               # reversal filed as income
+    led.add("2000.00", "out", "transfer")                           # transfer out (category kind)
+    led.add("900.00", "out", None, txn_type="own_transfer")         # transfer out, uncategorized
+    # outside the selected day
+    led.add("500.00", "in", None, when=datetime(2026, 9, 30, 23, 59, 59))
+    led.add("77.00", "out", None, when=datetime(2026, 10, 21, 0, 0, 0))
+    led.session.commit()
+
+
+@pytest.fixture
+def populated(ledger: Ledger) -> Ledger:
+    _populate(ledger)
+    return ledger
+
+
+def test_summary_separates_every_bucket(populated: Ledger) -> None:
+    s = cashflow_summary(populated.session, DAY, DAY)
+
+    assert s["income"] == D("1000.00")
+    assert s["uncategorized_in"] == D("300.00")
+    assert s["other_in"] == D("60.00")
+    assert s["expenses"] == D("255.00")
+    assert s["savings"] == D("100.00")
+    assert s["uncategorized_out"] == D("60.00")
+    assert s["other_out"] == D("15.00")
+    assert s["transfers_in"] == D("10007.00")
+    assert s["transfers_out"] == D("2900.00")
+    assert s["fees"] == D("5.00")
+    assert s["total_inflows"] == D("1360.00")
+    assert s["total_outflows"] == D("430.00")
+    assert s["net_cash_flow"] == D("930.00")
+
+
+def test_uncategorized_inflows_are_not_dropped(populated: Ledger) -> None:
+    s = cashflow_summary(populated.session, DAY, DAY)
+    categorized_only = D("1000.00") - D("255.00") - D("100.00")
+
+    assert s["uncategorized_in"] == D("300.00")
+    assert s["net_cash_flow"] != categorized_only
+    assert s["total_inflows"] >= s["income"] + s["uncategorized_in"]
+
+
+def test_buckets_reconcile_to_raw_totals_with_no_double_counting(populated: Ledger) -> None:
+    """Independent check: bucket sums must equal sums taken straight from the rows."""
+    s = cashflow_summary(populated.session, DAY, DAY)
+    rows = [
+        t for t in populated.session.query(Transaction).all()
+        if t.txn_at.date() == DAY
+    ]
+    raw_in = sum((t.amount for t in rows if t.direction == "in"), D("0"))
+    raw_out = sum((t.amount for t in rows if t.direction == "out"), D("0"))
+
+    assert s["total_inflows"] + s["transfers_in"] == raw_in
+    assert s["total_outflows"] + s["transfers_out"] == raw_out
+    # fees are a subset of existing buckets, never an extra one
+    assert s["fees"] <= s["expenses"]
+    assert sum(s[name] for name in BUCKETS) == raw_in + raw_out
+
+
+def test_internal_transfers_never_enter_cash_flow(populated: Ledger) -> None:
+    before = cashflow_summary(populated.session, DAY, DAY)
+    populated.add("123456.00", "in", None, txn_type="own_transfer")
+    populated.add("654321.00", "out", "transfer")
+    populated.session.commit()
+    after = cashflow_summary(populated.session, DAY, DAY)
+
+    for name in ("income", "uncategorized_in", "expenses", "savings", "uncategorized_out",
+                 "total_inflows", "total_outflows", "net_cash_flow"):
+        assert after[name] == before[name]
+    assert after["transfers_in"] == before["transfers_in"] + D("123456.00")
+    assert after["transfers_out"] == before["transfers_out"] + D("654321.00")
+
+
+def test_date_range_is_inclusive_of_end_day_and_excludes_neighbours(populated: Ledger) -> None:
+    wide = cashflow_summary(populated.session, date(2026, 9, 1), date(2026, 10, 31))
+    assert wide["uncategorized_in"] == D("800.00")   # 300 + the 500 from Sep 30
+    assert wide["uncategorized_out"] == D("137.00")  # 60 + the 77 from Oct 21
+
+    day = cashflow_summary(populated.session, DAY, DAY)
+    assert day["uncategorized_in"] == D("300.00")
+    assert day["uncategorized_out"] == D("60.00")
+
+
+def test_empty_database_returns_zeroes(db_session: Session) -> None:
+    s = cashflow_summary(db_session, DAY, DAY)
+
+    assert all(value == D("0") for value in s.values())
